# Public site origin used for canonical and Open Graph URLs.
# https only. No trailing slash. No path.
#
# Leave unset to use the GitHub Pages user-site default:
# https://anishkumarthe27.github.io
#
# After a custom domain is connected in GitHub Pages, set the same origin here
# and as the repository Actions variable SITE_URL (see docs/custom-domain.md).
# VITE_SITE_URL=https://www.example.com
VITE_SITE_URL=
